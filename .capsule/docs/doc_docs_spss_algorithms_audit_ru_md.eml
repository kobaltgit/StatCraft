        "text": "---"
      },
      "id": "blk_native_paragraph_1795702921459133400",
      "managed_by": "project_parser",
      "type": "paragraph"
    },
    {
      "data": {
        "level": 3,
        "text": "Блок 14: Сводные таблицы и форматирование вывода (`statcraft_reporting`)"
      },
      "id": "blk_native_heading_1795702921459134300",
