      "data": {
        "level": 3,
        "text": "Release v0.2.1: Mathematical Clean-Room Audit (Craft Anything) & Transform Block Finalization"
      },
      "id": "blk_native_heading_1795702921424596800",
      "managed_by": "project_parser",
      "type": "heading"
