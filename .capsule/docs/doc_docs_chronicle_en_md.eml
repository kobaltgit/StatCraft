      "data": {
        "level": 3,
        "text": "Phase: Instrumental Clean-Room Core Audit via Craft Anything MCP (Blocks 7–10)"
      },
      "id": "blk_native_heading_1794063483751692700",
      "managed_by": "project_parser",
      "type": "heading"
