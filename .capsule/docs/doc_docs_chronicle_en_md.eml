    {
      "data": {
        "level": 3,
        "text": "Phase 6.1: One-Sample Student's T Test (Compare Means)"
      },
      "id": "blk_native_heading_1795702921424099300",
      "managed_by": "project_parser",
      "type": "heading"
    },
