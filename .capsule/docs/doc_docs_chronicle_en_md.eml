      "data": {
        "text": "Implemented the supervised discretization procedure of continuous attributes from IBM SPSS Statistics — **Optimal Binning...** (`Transform -> Optimal Binning...`, command ID `transform.optimal_binning`):"
      },
      "id": "blk_native_paragraph_1795702921424542200",
