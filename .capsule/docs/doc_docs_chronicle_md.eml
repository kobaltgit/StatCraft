    {
      "data": {
        "level": 3,
        "text": "Этап 9.1: Линейная множественная регрессия (Multiple Linear Regression: `REGRESSION`)"
      },
      "id": "blk_native_heading_1795702921437627700",
      "managed_by": "project_parser",
      "type": "heading"
    },
    {
      "data": {
