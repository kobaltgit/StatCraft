      "data": {
        "level": 3,
        "text": "Фаза 114: Исправление рендеринга шрифтов в стиле таблиц — гармоничный Bold, Italic и Underline"
      },
      "id": "blk_native_heading_1795702921438473400",
      "managed_by": "project_parser",
      "type": "heading"
