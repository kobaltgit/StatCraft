      "data": {
        "level": 3,
        "text": "Фаза 5.2: Канон всех 12 главных меню и 100% паритет с IBM SPSS Statistics"
      },
      "id": "blk_native_heading_1795702921437342700",
      "managed_by": "project_parser",
